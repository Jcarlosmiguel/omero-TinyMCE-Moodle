{{!
    @template tiny_omeroembed/modal

    Modal wrapping local_omeroembed's author.php in an iframe - the page
    itself posts the generated embed HTML back to this modal's JS
    (see amd/src/ui.js) once the teacher clicks "Insert into page" inside it.

    Example context (json):
    {
        "iframeurl": "https://example.org/local/omeroembed/author.php?contextid=1&embedded=1"
    }
}}

{{< core/modal }}

    {{$title}}
        {{#str}} modaltitle, tiny_omeroembed {{/str}}
    {{/title}}

    {{$body}}
        <iframe src="{{iframeurl}}" style="width:100%; height:75vh; border:0;"></iframe>
    {{/body}}

    {{$footer}}
        {{!
            data-action="hide", not "cancel" - this modal extends core/modal
            directly (see amd/src/modal.js), not core/modal_save_cancel,
            which is the only base class that actually wires up a "cancel"
            action (via its own registerCloseOnCancel()). The plain core/modal
            class only ever registers a listener for data-action="hide" - a
            "cancel" button here had no listener attached at all and did
            nothing when clicked, confirmed against core/modal.js's own
            SELECTORS. hide() is the correct behaviour anyway: there's no
            save/cancel distinction for this modal, just close it.
        }}
        <button type="button" class="btn btn-secondary" data-action="hide">{{#str}} cancel, moodle {{/str}}</button>
    {{/footer}}
{{/ core/modal }}
